---
import { testimonial } from "../common/list.js";

const people = testimonial.flat();

// Matches Figma wall pattern: orange, white, black / white, orange, white / white, black, white
const variants = [
  "orange",
  "white",
  "black",
  "white",
  "orange",
  "white",
  "white",
  "black",
  "white",
];

const styles = {
  orange: {
    card: "bg-orange text-white shadow-[5px_5px_0_0_#1a1a1a]",
    quote: "text-black",
    rule: "border-white/40",
    role: "text-white/80",
  },
  white: {
    card: "bg-white text-black shadow-[5px_5px_0_0_#FA8816]",
    quote: "text-orange",
    rule: "border-black/15",
    role: "text-black/60",
  },
  black: {
    card: "bg-[#2D2D2D] text-white shadow-[5px_5px_0_0_#FA8816]",
    quote: "text-orange",
    rule: "border-white/25",
    role: "text-white/70",
  },
};
---

<section class="bg-peach px-4 py-16 lg:px-10 lg:py-24">
  <div class="mx-auto flex max-w-screen-xl flex-col items-center gap-10 lg:gap-14">
    <div class="flex flex-col items-center gap-3 text-center lg:gap-4">
      <h2
        class="max-w-[920px] font-header text-3xl/[1.2] font-bold md:text-4xl/[1.2] lg:text-[48px]/[1.2]"
      >
        “And what’s the experience of the people who have
        already walked this path?”
      </h2>
      <p
        class="font-header text-sm font-semibold tracking-[0.08em] text-black/60 lg:text-base"
      >
        WALL OF LOVE
      </p>
    </div>

    <div class="grid w-full grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {
        people.map((item, index) => {
          const variant = variants[index % variants.length];
          const s = styles[variant];
          return (
            <article
              class:list={[
                "flex-col gap-4 rounded-[20px] p-5 lg:p-6",
                s.card,
                index >= 3 ? "hidden lg:flex" : "flex",
              ]}
            >
              <span
                class:list={[
                  "font-header text-5xl leading-none",
                  s.quote,
                ]}
                aria-hidden="true"
              >
                “
              </span>
              <p class="line-clamp-6 text-sm leading-[1.45] lg:text-base">
                {item.text}
              </p>
              <hr class:list={["mt-auto border-t", s.rule]} />
              <div class="flex items-center gap-3">
                <img
                  src={item.img}
                  alt=""
                  class="h-11 w-11 rounded-full object-cover"
                />
                <div class="flex min-w-0 flex-col">
                  <p class="truncate font-header text-base font-bold leading-tight">
                    {item.name}
                  </p>
                  <p
                    class:list={[
                      "truncate text-sm leading-tight",
                      s.role,
                    ]}
                  >
                    {item.cohort}
                  </p>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
