---
const list = [
  {
    n: "01",
    title:
      "Join the community of passionate Bitcoin devs and enthusiasts",
    link: "https://discord.com/invite/STeQFVEWf9",
    buttonText: "Take me to Discord   → ",
    img: "/journeyGuide/1.webp",
  },
  {
    n: "02",
    title:
      "Grow your Bitcoin knowledge with hands-on club activities",
    link: "/clubs",
    buttonText: "Show me the clubs   → ",
    img: "/journeyGuide/2.webp",
  },
  {
    n: "03",
    title:
      "Gain deeper understanding of Bitcoin tech with fellow aspiring Bitcoin devs",
    link: "/cohorts/",
    buttonText: "Let me explore the study cohorts   → ",
    img: "/journeyGuide/3.webp",
  },
  {
    n: "04",
    title:
      "Kickstart your Bitcoin career with our paid Fellowship Program",
    link: "/fellowship",
    buttonText: "Tell me more about the fellowship   → ",
    img: "/journeyGuide/4.webp",
  },
  {
    n: "05",
    title:
      "Collaborate and build together with Bitcoin Devs in real life at Bitspace",
    link: "/bitspace",
    buttonText: "I’d like to know more about Bitspace   → ",
    img: "/journeyGuide/5.webp",
  },
];
---

<section class="bg-[#F7F7F7] px-4 py-16 lg:px-10 lg:py-24">
  <div class="mx-auto flex max-w-screen-xl flex-col gap-10 lg:gap-16">
    <div class="flex flex-col items-center gap-4 text-center lg:gap-5">
      <h2
        class="max-w-[980px] font-header text-3xl/[1.2] font-bold md:text-4xl/[1.2] lg:text-[48px]/[1.2]"
      >
        “And, if I wanted to start my Bitcoin dev journey
        with you, what would that look like?”
      </h2>
      <p class="max-w-[720px] text-base leading-[1.4] text-black/80 lg:text-[22px]">
        Well, we’re glad you asked! Here’s what your journey
        could look like with us...
      </p>
    </div>

    <ol class="relative mx-auto w-full max-w-[1100px]">
      <!-- dashed spine -->
      <div
        aria-hidden="true"
        class="absolute bottom-8 left-[19px] top-8 w-px border-l border-dashed border-black/30 lg:left-[23px]"
      >
      </div>

      <div class="flex flex-col gap-10 lg:gap-14">
        {
          list.map((item) => (
            <li class="relative grid grid-cols-[40px_1fr] gap-x-4 lg:grid-cols-[48px_1fr_minmax(280px,420px)] lg:items-start lg:gap-x-8">
              <div class="relative z-10 flex justify-center">
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-black font-header text-sm font-bold text-white lg:h-12 lg:w-12 lg:text-base">
                  {item.n}
                </span>
              </div>

              <div class="flex flex-col gap-2 pt-1 lg:gap-3 lg:pt-2">
                <h3 class="font-header text-xl font-bold leading-[1.25] lg:text-[28px]">
                  {item.title}
                </h3>
                <a
                  href={item.link}
                  class="w-fit font-header text-base font-semibold text-orange hover:underline lg:text-xl"
                  target={
                    item.link.startsWith("http")
                      ? "_blank"
                      : undefined
                  }
                  rel={
                    item.link.startsWith("http")
                      ? "noopener noreferrer"
                      : undefined
                  }
                >
                  {item.buttonText}
                </a>

                <!-- mobile: image under each step -->
                <img
                  src={item.img}
                  alt=""
                  class="mt-3 aspect-[16/10] w-full rounded-[18px] object-cover lg:hidden"
                />
              </div>

              <!-- desktop: image beside each step -->
              <img
                src={item.img}
                alt=""
                class="mt-1 hidden aspect-[16/10] w-full rounded-[20px] object-cover lg:block"
              />
            </li>
          ))
        }
      </div>
    </ol>
  </div>
</section>
