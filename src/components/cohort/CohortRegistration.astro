---
import Application from "../common/Application";

interface Props {
  cohortName: string;
  role: string;
  regOpen: boolean;
}

const { cohortName, role, regOpen } = Astro.props;
---

{
  // To take applications on this site again, pass regOpen={true} from the
  // cohort page: that mounts the React form (MUI + axios, ~60 KB gz). While
  // it's false, registration happens on app.bitshala.org and this block is
  // plain HTML with no JavaScript.
  regOpen ? (
    <Application client:only cohortName={cohortName} role={role} regOpen />
  ) : (
    <section id="register">
      <div class="my-10 items-center justify-center text-center">
        <h1 class="mb-2 font-header text-3xl font-bold text-orange lg:text-5xl">
          Registration for the cohort is now open
        </h1>
        <p class="mb-12 lg:text-xl">register to proceed</p>
        <a
          href="https://app.bitshala.org"
          target="_blank"
          rel="noopener noreferrer"
          class="my-5 rounded-lg bg-orange px-32 py-4 text-lg font-bold text-black hover:bg-black hover:text-white"
        >
          Register
        </a>
      </div>
    </section>
  )
}
