---
// Live summit agenda: contribution-grid banner, the all-day kickoff line,
// a sticky bar of day tabs and type filters, then one panel per day with a
// Morning series · LUNCH · Afternoon series on a time rail. Panels are all
// rendered here; the script below only switches tabs, filters cards and
// rotates the banner words. Sizes follow the container (@container
// boss-agenda), not the window.
import type {
  BossDay,
  BossSchedule,
  BossSession,
} from "../../lib/bossWinter2026";
import {
  GH_GRIDS,
  GH_WORDS,
  ghDelayStep,
} from "../../lib/bossGhGrid";

interface Props {
  schedule: BossSchedule;
}

const { schedule } = Astro.props;

const mins = (t: string) => {
  const [h, m] = t.split(":").map(Number);
  return h * 60 + m;
};
// 12-hour without AM/PM, as on the time chips
const clock = (t: string) => {
  const m = mins(t);
  return `${Math.floor(m / 60) % 12 || 12}:${String(m % 60).padStart(2, "0")}`;
};
const clockAmPm = (t: string) =>
  `${clock(t)} ${mins(t) >= 720 ? "PM" : "AM"}`;
const range = (a: string, b: string) =>
  `${clockAmPm(a)} - ${clockAmPm(b)}`;
const two = (n: number) => String(n).padStart(2, "0");
const names = (list: string[]) =>
  list.length < 2
    ? list.join("")
    : `${list.slice(0, -1).join(", ")} & ${list[list.length - 1]}`;
const splitTitle = (title: string) => {
  const cut = title.indexOf(": ");
  return cut > 0
    ? {
        main: title.slice(0, cut + 1),
        sub: title.slice(cut + 2),
      }
    : { main: title, sub: "" };
};
const plural = (n: number, w: string) =>
  `${n} ${w}${n === 1 ? "" : "s"}`;
const DOW = [
  "Sun",
  "Mon",
  "Tue",
  "Wed",
  "Thu",
  "Fri",
  "Sat",
];
const dow = (date: string) => {
  const [y, m, d] = date.split("-").map(Number);
  return DOW[new Date(Date.UTC(y, m - 1, d)).getUTCDay()];
};
const tally = (list: BossSession[]) => ({
  all: list.length,
  talk: list.filter((s) => s.kind === "talk").length,
  workshop: list.filter((s) => s.kind === "workshop")
    .length,
  open: list.filter((s) => s.kind === "open").length,
});
const countLine = (d: BossDay) => {
  const c = tally(d.sessions);
  return [
    c.workshop && plural(c.workshop, "workshop"),
    c.talk && plural(c.talk, "talk"),
    c.open && `${c.open} open stage`,
  ]
    .filter(Boolean)
    .join(" · ");
};

const TAGS = {
  talk: "Talk",
  workshop: "Workshop",
  open: "Open stage",
};
// Day colours in summit order: Mon mint, Tue coral, Wed butter, Thu lime
const ACCENTS = ["mint", "coral", "butter", "lime"];

const lunch = schedule.lunch;
const lunchMins = mins(lunch.start);

// The kickoff day has no sessions and sits above the tabs
const kickoffIndex = schedule.days.findIndex(
  (d) => d.sessions.length === 0,
);
const kickoff =
  kickoffIndex >= 0
    ? {
        ...schedule.days[kickoffIndex],
        index: kickoffIndex + 1,
        accent: ACCENTS[kickoffIndex % ACCENTS.length],
      }
    : null;

// Session series are numbered across the whole summit
let seriesNo = 0;
const days = schedule.days
  .map((d, i) => ({ d, i }))
  .filter(({ d }) => d.sessions.length > 0)
  .map(({ d, i }) => {
    const am = d.sessions.filter(
      (s) => mins(s.start) < lunchMins,
    );
    const pm = d.sessions.filter(
      (s) => mins(s.start) >= lunchMins,
    );
    const series = [
      {
        part: "Morning",
        list: am,
        lunchAfter: pm.length > 0,
      },
      { part: "Afternoon", list: pm, lunchAfter: false },
    ]
      .filter((s) => s.list.length > 0)
      .map((s) => ({ ...s, no: ++seriesNo }));
    return {
      ...d,
      accent: ACCENTS[i % ACCENTS.length],
      dow: dow(d.date),
      counts: tally(d.sessions),
      series,
    };
  });

const filters = [
  { id: "all", label: "All" },
  { id: "talk", label: "Talks" },
  { id: "workshop", label: "Workshops" },
] as const;
const first = days[0];
---

<div class="boss-agenda" data-boss-agenda>
  <div class="boss-schedule">
    <div
      class="gh-box"
      style={`--accent: var(--${GH_WORDS[0].accent})`}
      data-gh
    >
      <div
        class="gh-grid"
        role="img"
        aria-label={`${GH_WORDS.map((w) => w.text).join(", ")} spelled out in a contribution grid`}
      >
        {
          GH_GRIDS[0].map((v, i) => (
            <span
              class="gh"
              data-v={v}
              style={`--d: ${ghDelayStep(i)}`}
            />
          ))
        }
      </div>
    </div>

    {
      kickoff && (
        <div
          class="kick"
          style={`--accent: var(--${kickoff.accent})`}
          role="note"
          aria-label={`${dow(kickoff.date)} ${kickoff.day} ${schedule.month}, Day ${two(kickoff.index)}: ${kickoff.title}, ${kickoff.allDay ? "all day" : range(kickoff.start!, kickoff.end!)}`}
        >
          <div>
            <p class="kick__kicker">
              {dow(kickoff.date)} · {schedule.month}{" "}
              {kickoff.day} · Day {two(kickoff.index)}
            </p>
            <h3 class="kick__title">{kickoff.title}</h3>
          </div>
          <div class="kick__meta">
            <span class="kick__time">
              {kickoff.allDay
                ? "All day"
                : range(kickoff.start!, kickoff.end!)}
            </span>
            {kickoff.note && (
              <span class="kick__note">{kickoff.note}</span>
            )}
          </div>
        </div>
      )
    }

    <div class="boss-bar" data-boss-bar>
      <div
        class="boss-tabs"
        role="tablist"
        aria-label="Summit days"
      >
        {
          days.map((d) => (
            <button
              type="button"
              role="tab"
              class="boss-tab"
              style={`--accent: var(--${d.accent})`}
              id={`boss-tab-${d.day}`}
              aria-controls={`boss-panel-${d.day}`}
              aria-selected={d === first ? "true" : "false"}
              tabindex={d === first ? 0 : -1}
              data-date={d.date}
            >
              <span class="boss-tab__dow">{d.dow}</span>
              <span class="boss-tab__num">{d.day}</span>
            </button>
          ))
        }
      </div>
      <div
        class="boss-filters"
        role="group"
        aria-label="Show"
      >
        {
          filters.map((f) => (
            <button
              type="button"
              class="boss-fchip"
              aria-pressed={
                f.id === "all" ? "true" : "false"
              }
              data-filter={f.id}
            >
              {f.id !== "all" && (
                <span
                  class={`boss-fchip__sw boss-fchip__sw--${f.id}`}
                  aria-hidden="true"
                />
              )}
              <span>{f.label}</span>
              <span class="boss-fchip__n" data-count>
                {first.counts[f.id]}
              </span>
            </button>
          ))
        }
      </div>
    </div>

    {
      days.map((d) => (
        <div
          class="boss-panel"
          style={`--accent: var(--${d.accent})`}
          role="tabpanel"
          id={`boss-panel-${d.day}`}
          aria-labelledby={`boss-tab-${d.day}`}
          hidden={d !== first}
          data-counts={JSON.stringify(d.counts)}
        >
          <header class="boss-dayhead">
            <h3 class="boss-dayhead__title">{d.title}</h3>
            <div class="boss-dayhead__meta">
              {d.start && d.end && (
                <span class="boss-dayhead__time">
                  {range(d.start, d.end)}
                </span>
              )}
              <span class="boss-dayhead__count">
                {countLine(d)}
              </span>
            </div>
          </header>

          {d.series.map((s) => (
            <section
              aria-label={`Session ${two(s.no)} ${s.part}`}
              data-series
            >
              <div class="ser-head">
                <span class="ser-head__name">
                  Session {two(s.no)}
                  <span class="ser-head__part">
                    {s.part}
                  </span>
                </span>
                <span class="ser-head__range">
                  {range(
                    s.list[0].start,
                    s.list[s.list.length - 1].end,
                  )}
                </span>
              </div>

              <ol class="boss-rail">
                {s.list.map((x) => {
                  const t = splitTitle(x.title);
                  return (
                    <li
                      class="boss-slot"
                      data-kind={x.kind}
                    >
                      <span class="boss-slot__time">
                        <span class="boss-chip">
                          {clock(x.start)}
                        </span>
                        <span class="boss-slot__dur">
                          {mins(x.end) - mins(x.start)} min
                        </span>
                      </span>
                      <div
                        class={`boss-card boss-card--${x.kind}`}
                      >
                        <span class={`tag tag--${x.kind}`}>
                          {TAGS[x.kind]}
                        </span>
                        <span class="boss-card__title">
                          {t.main}
                          {t.sub && (
                            <span class="boss-card__sub">
                              {t.sub}
                            </span>
                          )}
                        </span>
                        {x.speakers.length > 0 ? (
                          <span class="boss-card__by">
                            <span class="boss-card__byword">
                              by
                            </span>{" "}
                            {names(x.speakers)}
                          </span>
                        ) : (
                          <span class="boss-card__by boss-card__by--open">
                            Open floor
                          </span>
                        )}
                        {x.about && (
                          <p class="boss-card__about">
                            {x.about}
                          </p>
                        )}
                      </div>
                    </li>
                  );
                })}
              </ol>
              <p
                class="boss-empty"
                data-part={s.part.toLowerCase()}
                hidden
              />

              {s.lunchAfter && (
                <div
                  class="boss-lunch"
                  role="note"
                  aria-label={`Lunch, ${range(lunch.start, lunch.end)}`}
                >
                  <span class="boss-chip">
                    {clock(lunch.start)}
                  </span>
                  <span class="boss-lunch__label">
                    Lunch
                  </span>
                  <span class="boss-lunch__span">
                    {clock(lunch.start)} –{" "}
                    {clock(lunch.end)} ·{" "}
                    {mins(lunch.end) - lunchMins} min
                  </span>
                </div>
              )}
            </section>
          ))}
        </div>
      ))
    }
  </div>
</div>

<script>
  import { GH_GRIDS, GH_WORDS } from "../../lib/bossGhGrid";

  type Filter = "all" | "talk" | "workshop";
  const EMPTY: Record<Filter, string> = {
    all: "Nothing",
    talk: "No talks",
    workshop: "No workshops",
  };

  document
    .querySelectorAll<HTMLElement>("[data-boss-agenda]")
    .forEach((root) => {
      const tabs = [
        ...root.querySelectorAll<HTMLButtonElement>(
          '[role="tab"]',
        ),
      ];
      const chips = [
        ...root.querySelectorAll<HTMLButtonElement>(
          "[data-filter]",
        ),
      ];
      const bar = root.querySelector<HTMLElement>(
        "[data-boss-bar]",
      )!;
      const panelOf = (tab: HTMLButtonElement) =>
        document.getElementById(
          tab.getAttribute("aria-controls")!,
        )!;
      let filter: Filter = "all";

      // Keep the sticky bar clear of the site's fixed navbar
      const nav =
        document.querySelector<HTMLElement>("body > nav");
      if (
        nav &&
        getComputedStyle(nav).position === "fixed"
      ) {
        const place = () =>
          root.style.setProperty(
            "--boss-bar-top",
            `${nav.offsetHeight}px`,
          );
        place();
        new ResizeObserver(place).observe(nav);
      }

      const current = () =>
        tabs.find(
          (t) => t.getAttribute("aria-selected") === "true",
        )!;

      function applyFilter() {
        const panel = panelOf(current());
        const counts = JSON.parse(
          panel.dataset.counts || "{}",
        );
        // A filter the chosen day has nothing for falls back to All
        if (filter !== "all" && !counts[filter])
          filter = "all";
        chips.forEach((chip) => {
          const id = chip.dataset.filter as Filter;
          chip.setAttribute(
            "aria-pressed",
            String(id === filter),
          );
          chip.disabled = id !== "all" && !counts[id];
          chip.querySelector("[data-count]")!.textContent =
            String(counts[id] ?? 0);
        });
        panel
          .querySelectorAll<HTMLElement>("[data-series]")
          .forEach((series) => {
            let shown = 0;
            series
              .querySelectorAll<HTMLElement>("[data-kind]")
              .forEach((slot) => {
                const on =
                  filter === "all" ||
                  slot.dataset.kind === filter;
                slot.hidden = !on;
                if (on) shown++;
              });
            series.querySelector<HTMLElement>(
              ".boss-rail",
            )!.hidden = shown === 0;
            const empty =
              series.querySelector<HTMLElement>(
                ".boss-empty",
              )!;
            empty.hidden = shown > 0;
            empty.textContent = `${EMPTY[filter]} this ${empty.dataset.part}`;
          });
      }

      function select(
        tab: HTMLButtonElement,
        focus = false,
      ) {
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute("aria-selected", String(on));
          t.tabIndex = on ? 0 : -1;
          panelOf(t).hidden = !on;
        });
        if (focus) tab.focus();
        applyFilter();
        // If the bar is stuck, bring the new day's top up under it
        const panel = panelOf(tab);
        const barBottom =
          bar.getBoundingClientRect().bottom;
        if (panel.getBoundingClientRect().top < barBottom) {
          window.scrollBy(
            0,
            panel.getBoundingClientRect().top - barBottom,
          );
        }
      }

      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => select(tab));
        tab.addEventListener("keydown", (e) => {
          const last = tabs.length - 1;
          const next =
            e.key === "ArrowRight" || e.key === "ArrowDown"
              ? i === last
                ? 0
                : i + 1
              : e.key === "ArrowLeft" || e.key === "ArrowUp"
                ? i === 0
                  ? last
                  : i - 1
                : e.key === "Home"
                  ? 0
                  : e.key === "End"
                    ? last
                    : -1;
          if (next < 0) return;
          e.preventDefault();
          select(tabs[next], true);
        });
      });

      chips.forEach((chip) =>
        chip.addEventListener("click", () => {
          filter = chip.dataset.filter as Filter;
          applyFilter();
        }),
      );

      // Open on today's tab during the summit (IST, UTC+5:30)
      const today = new Date(Date.now() + 330 * 60_000)
        .toISOString()
        .slice(0, 10);
      const todayTab = tabs.find(
        (t) => t.dataset.date === today,
      );
      if (todayTab) select(todayTab);

      // Banner: rotate the spelled word every 2.2s
      const box =
        root.querySelector<HTMLElement>("[data-gh]");
      const cells = box
        ? [...box.querySelectorAll<HTMLElement>(".gh")]
        : [];
      const still = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      let step = 0;
      const show = (k: number) => {
        box!.style.setProperty(
          "--accent",
          `var(--${GH_WORDS[k].accent})`,
        );
        GH_GRIDS[k].forEach(
          (v, i) => (cells[i].dataset.v = v),
        );
      };
      if (box) {
        setInterval(() => {
          if (document.hidden) return;
          if (still.matches) {
            if (step) show((step = 0));
            return;
          }
          step = (step + 1) % GH_WORDS.length;
          show(step);
        }, 2200);
      }
    });
</script>

<style>
  /* Tokens from the BOSS Winter 2026 design system. Dark theme only;
     flat outlines, no shadows, gradients or glows. */
  .boss-agenda {
    --plum-950: #1c0716;
    --plum-900: #250e21;
    --plum-800: #3a1530;
    --plum-500: #8e2f72;
    --ink: #f5f3f0;
    --ink-muted: #bfc3ce;
    --ink-muted-olive: #c9c6a6;
    --ink-muted-plum: #c9b3c4;
    --frame: #8da2c4;
    --slate: #3c4253;
    --slate-line: #646c82;
    --olive: #45452f;
    --olive-line: #d4cf4a;
    --chip: #f2f2f2;
    --on-chip: #1c0716;
    --highlight: #f3f09b;
    --coral: #f27b7b;
    --butter: #f4e66c;
    --lime: #d7f55a;
    --mint: #7ed08f;
    --focus: #d7f55a;
    --font-display: "Dx Slight", "Arial Narrow", sans-serif;
    --font-sans:
      "Inter", system-ui, -apple-system, "Segoe UI",
      sans-serif;

    container-type: inline-size;
    container-name: boss-agenda;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }
  .boss-agenda *,
  .boss-agenda *::before,
  .boss-agenda *::after {
    box-sizing: border-box;
  }
  .boss-agenda [hidden] {
    display: none !important;
  }
  .boss-agenda :focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .boss-schedule {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* ---------- Contribution-grid banner ---------- */
  .gh-box {
    margin: 0 0 14px;
    padding: 16px;
    border: 2px dashed var(--frame);
    border-radius: 16px;
  }
  .gh-grid {
    display: grid;
    grid-template-columns: repeat(53, minmax(0, 1fr));
    gap: 4px;
  }
  .gh {
    display: block;
    aspect-ratio: 1;
    border-radius: 3px;
    background: var(--plum-900);
    transition: background-color 0.35s ease;
    transition-delay: calc(var(--d, 0) * 40ms);
  }
  .gh[data-v="1"] {
    background: var(--plum-800);
  }
  .gh[data-v="2"] {
    background: var(--plum-500);
  }
  .gh[data-v="on"] {
    background: var(--accent);
  }

  /* ---------- Kickoff line ---------- */
  .kick {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px 24px;
    margin: 0 0 14px;
    padding: 16px 20px 18px;
    border: 2px dashed var(--frame);
    border-radius: 12px;
  }
  .kick__kicker {
    margin: 0 0 6px;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .kick__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-synthesis: none;
    font-size: 40px;
    line-height: 1.05;
  }
  .kick__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    text-align: right;
  }
  .kick__time {
    font-weight: 500;
    font-size: 17px;
  }
  .kick__note {
    font-weight: 500;
    font-size: 14px;
    color: var(--ink-muted);
  }

  /* ---------- Sticky bar: day tabs + filters ---------- */
  .boss-bar {
    position: sticky;
    top: var(--boss-bar-top, 0px);
    z-index: 5;
    margin: 0 -32px;
    padding: 10px 32px 12px;
    background: var(--plum-950);
    border-bottom: 2px solid var(--plum-800);
  }
  .boss-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .boss-tab {
    appearance: none;
    cursor: pointer;
    font: inherit;
    flex: 0 0 auto;
    min-width: 76px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 8px 14px 9px;
    border: 2px solid var(--plum-500);
    border-radius: 12px;
    background: transparent;
    color: var(--ink);
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }
  .boss-tab:hover {
    border-color: var(--accent);
  }
  .boss-tab__dow {
    font-weight: 600;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .boss-tab__num {
    font-family: var(--font-display);
    font-weight: 500;
    font-synthesis: none;
    font-size: 32px;
    line-height: 1;
    color: var(--accent);
  }
  .boss-tab[aria-selected="true"] {
    background: var(--highlight);
    border-color: var(--highlight);
  }
  .boss-tab[aria-selected="true"] .boss-tab__dow,
  .boss-tab[aria-selected="true"] .boss-tab__num {
    color: var(--on-chip);
  }

  .boss-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
  }
  .boss-fchip {
    appearance: none;
    cursor: pointer;
    font: inherit;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 4px 6px 4px 12px;
    border: 2px solid var(--frame);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-weight: 600;
    font-size: 14px;
    line-height: 1.2;
  }
  .boss-fchip:hover {
    border-color: var(--ink);
  }
  .boss-fchip__sw {
    width: 22px;
    height: 16px;
    border: 2px solid;
    border-radius: 4px;
  }
  .boss-fchip__sw--talk {
    background: var(--slate);
    border-color: var(--slate-line);
  }
  .boss-fchip__sw--workshop {
    background: var(--olive);
    border-color: var(--olive-line);
  }
  .boss-fchip__n {
    min-width: 28px;
    padding: 4px 8px;
    border-radius: 999px;
    background: var(--plum-800);
    color: var(--ink);
    font-size: 13px;
    line-height: 1;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .boss-fchip[aria-pressed="true"] {
    background: var(--ink);
    border-color: var(--ink);
