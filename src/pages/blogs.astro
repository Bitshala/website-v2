---
import Layout from "../layouts/Layout.astro";

type FeedItem = {
  id: string;
  type: "podcast" | "article";
  title: string;
  text: string;
  date: string;
  thumbnail: string | null;
  duration?: number;
  articleUrl?: string;
  postUrl: string;
};
type Feed = { updatedAt: string | null; items: FeedItem[] };

const headerProps = {
  image: "/cohort/hero.webp",
  removePadding: true,
};
const isVisible = true;

// Written by scripts/fetch-x.js in the "Update X feed" workflow. The site
// never calls the X API. Globbed so a missing file renders the empty state
// instead of failing the build.
const feedModules = import.meta.glob<{ default: Feed }>(
  "../../data/podcasts-articles.json",
  { eager: true },
);
const feed = Object.values(feedModules)[0]?.default;
const items = (feed?.items ?? [])
  .filter(
    (item) =>
      item.type === "podcast" || item.type === "article",
  )
  .sort((a, b) => Date.parse(b.date) - Date.parse(a.date));
const podcastCount = items.filter(
  (item) => item.type === "podcast",
).length;
const articleCount = items.length - podcastCount;

const tabs = [
  { name: "all", label: "All", count: items.length },
  {
    name: "podcast",
    label: "Podcasts",
    count: podcastCount,
  },
  {
    name: "article",
    label: "Articles",
    count: articleCount,
  },
];

// Pinned to IST: without it a UTC CI build and a local build disagree by a day
// on anything posted after 18:30 UTC.
const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("en-US", {
    timeZone: "Asia/Kolkata",
    month: "short",
    day: "numeric",
    year: "numeric",
  });

function formatDuration(durationMs?: number) {
  if (!durationMs) return "";

  const totalSeconds = Math.floor(durationMs / 1000);
  const hours = Math.floor(totalSeconds / 3600);
  const minutes = Math.floor((totalSeconds % 3600) / 60);
  const seconds = totalSeconds % 60;

  return hours > 0
    ? `${hours}:${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`
    : `${minutes}:${String(seconds).padStart(2, "0")}`;
}

const updatedAt = feed?.updatedAt
  ? new Date(feed.updatedAt).toLocaleString("en-US", {
      timeZone: "Asia/Kolkata",
      dateStyle: "medium",
      timeStyle: "short",
    }) + " IST"
  : null;
---

<Layout
  title="Blogs & Podcasts"
  headerProps={headerProps}
  isVisible={isVisible}
>
  <div
    slot="headerChild"
    class="mx-auto -mt-16 flex max-w-screen-xl flex-col"
  >
    <div slot="after-heading">
      <h1
        class="text-center font-header text-4xl font-bold leading-[100%] text-[#F7F7F7] [text-shadow:6px_6px_24px_rgba(0,0,0,0.32)] md:text-6xl lg:text-[124px]"
      >
        Blogs & Podcasts
      </h1>
      <p
        class="mt-3 px-4 text-center text-[18px] font-medium leading-[120%] text-[#F7F7F7] [text-shadow:4px_4px_8px_rgba(0,0,0,0.55)] md:mt-5 md:px-0 md:text-[24px] lg:text-[32px]"
      >
        Ideas worth reading. Conversations worth staying
        for.<br class="hidden lg:inline" />
        Explore original articles and full-length Bitcoin Talks.
      </p>
    </div>
  </div>

  <div
    class="mx-auto max-w-screen-xl px-4 py-10 md:px-6 lg:py-14"
  >
    {
      items.length === 0 ? (
        <div class="rounded-3xl border border-dashed border-black/20 bg-peach px-6 py-20 text-center">
          <h2 class="font-header text-2xl font-bold">
            Nothing here yet
          </h2>
          <p class="mt-2 font-base text-black/60">
            New articles and Bitcoin Talks episodes will
            appear here automatically. Check back soon.
          </p>
        </div>
      ) : (
        <>
          <div
            class="mb-8 flex justify-center md:mb-10"
            role="tablist"
            aria-label="Filter blogs and podcasts"
          >
            <div class="inline-flex rounded-full border border-black/10 bg-peach p-1.5 shadow-sm">
              {tabs.map((tab, index) => (
                <button
                  class="content-tab flex items-center gap-2 rounded-full px-4 py-2.5 font-header text-base font-bold transition-colors md:px-7 md:text-lg"
                  type="button"
                  role="tab"
                  aria-selected={String(index === 0)}
                  aria-controls="feed-panel"
                  data-filter={tab.name}
                  tabindex={index === 0 ? undefined : "-1"}
                >
                  {tab.label}
                  <span
                    class:list={[
                      "rounded-full px-2 py-0.5 font-base text-xs",
                      index === 0
                        ? "bg-white/15"
                        : "bg-black/10",
                    ]}
                  >
                    {tab.count}
                  </span>
                </button>
              ))}
            </div>
          </div>

          <section id="feed-panel" role="tabpanel">
            <div class="grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6 lg:grid-cols-3">
              {items.map((item) => {
                const isPodcast = item.type === "podcast";
                return (
                  <a
                    href={
                      isPodcast
                        ? item.postUrl
                        : (item.articleUrl ?? item.postUrl)
                    }
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex flex-col overflow-hidden rounded-2xl border border-black/10 bg-peach transition-all hover:-translate-y-1 hover:border-orange hover:shadow-lg"
                    data-type={item.type}
                  >
                    {item.thumbnail && (
                      <div class="relative aspect-video w-full overflow-hidden bg-black">
                        <img
                          class="h-full w-full object-cover transition-transform group-hover:scale-105"
                          src={item.thumbnail}
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />
                        {isPodcast && item.duration && (
                          <span class="absolute bottom-2 right-2 rounded bg-black/80 px-1.5 py-0.5 font-base text-xs font-bold text-white">
                            {formatDuration(item.duration)}
                          </span>
                        )}
                      </div>
                    )}
                    <div class="flex flex-1 flex-col p-5 sm:p-6">
                      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 font-base text-sm text-black/60">
                        <span>{formatDate(item.date)}</span>
                        {isPodcast && item.duration && (
                          <>
                            <span>·</span>
                            <span>
                              {formatDuration(
                                item.duration,
                              )}
                            </span>
                          </>
                        )}
                      </div>
                      <h2 class="mt-3 line-clamp-3 font-header text-xl font-bold leading-[1.25] text-black transition-colors group-hover:text-orange md:text-2xl">
                        {item.title}
                      </h2>
                      <p
                        class="mt-3 line-clamp-3 flex-1 font-base text-base leading-relaxed text-black/80"
                        style="font-weight: 400;"
                      >
                        {item.text}
                      </p>
                      <div class="mt-5 flex items-center justify-between gap-3">
                        <span class="w-fit rounded-full bg-orange px-3 py-1 font-base text-xs font-bold uppercase tracking-wide text-white">
                          {isPodcast
                            ? "Podcast"
                            : "Article"}
                        </span>
                        <span
                          class="font-header text-sm text-orange transition-transform group-hover:translate-x-1"
                          style="font-weight: 600;"
                        >
                          {isPodcast
                            ? "Watch on X ↗"
                            : "Read →"}
                        </span>
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        </>
      )
    }

    {
      updatedAt && (
        <p class="mt-10 text-center font-base text-sm text-black/50">
          Last updated {updatedAt}
        </p>
      )
    }
  </div>

  <style>
    .content-tab[aria-selected="true"] {
      background: #333333;
      color: #f7f7f7;
    }

    .content-tab[aria-selected="false"] {
      color: rgba(51, 51, 51, 0.62);
    }
  </style>

  <script>
    const tabButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        "[data-filter]",
      ),
    );
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-type]"),
    );

    function activateTab(name: string, focus = false) {
      tabButtons.forEach((button) => {
        const isActive = button.dataset.filter === name;
        button.setAttribute(
          "aria-selected",
          String(isActive),
        );
        button.tabIndex = isActive ? 0 : -1;
        if (focus && isActive) button.focus();

        const count = button.querySelector("span");
        count?.classList.toggle("bg-white/15", isActive);
        count?.classList.toggle("bg-black/10", !isActive);
      });

      cards.forEach((card) => {
        card.hidden =
          name !== "all" && card.dataset.type !== name;
      });
    }

    tabButtons.forEach((button, index) => {
      button.addEventListener("click", () => {
        activateTab(button.dataset.filter ?? "all");
      });

      button.addEventListener("keydown", (event) => {
        if (
          ![
            "ArrowLeft",
            "ArrowRight",
            "Home",
            "End",
          ].includes(event.key)
        )
          return;

        event.preventDefault();
        let nextIndex = index;
        if (event.key === "ArrowLeft") {
          nextIndex =
            (index - 1 + tabButtons.length) %
            tabButtons.length;
        } else if (event.key === "ArrowRight") {
          nextIndex = (index + 1) % tabButtons.length;
        } else if (event.key === "Home") {
          nextIndex = 0;
        } else if (event.key === "End") {
          nextIndex = tabButtons.length - 1;
        }

        activateTab(
          tabButtons[nextIndex].dataset.filter ?? "all",
          true,
        );
      });
    });
  </script>
</Layout>
